# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Simulation output. Runs are reproducible from the calibrated manifest and
# a seed, so results are regenerated and not versioned.
output/

# Third-party source material kept locally for reference. These are other
# people's copyrighted papers and are not ours to redistribute.
literature/

# Confidential peer review correspondence.
FRL/

# The manuscript and its working notes. This repository carries the model, and
# the paper is written beside it and not inside it. The two checks that
# compare a printed figure against a stored run skip when the article is not
# present and run when it is.
EconMod/

# LaTeX build products. The manuscript source is versioned, its output is not.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.abs
*.toc

# Editor and OS
.vscode/
.idea/
.DS_Store
